    "compilerOptions": {
        "module": "CommonJS",
        "target": "ES2020",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": false,
        "outDir": "../../lib"
    },
    "include": [
        "*.ts",
        "content/*.ts",
        "../config/genkit.config.ts"
    ]
}